# =============================================================================
# KI-TURB V3 — root .gitignore
# Covers: Python app (ki-turb_multi_agents) + CFD solvers (OpenLB / SolverApps)
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & local environment
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
secrets.toml
**/credentials.json
**/service-account*.json

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Virtual environments
.venv/
venv/
ENV/
env/
myenv/
.env/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Streamlit / app runtime
# -----------------------------------------------------------------------------
.streamlit/secrets.toml
ki-turb_multi_agents/.streamlit/secrets.toml

# Runtime simulation jobs (regenerated by the lab)
ki-turb_multi_agents/simulations/**
!ki-turb_multi_agents/simulations/.gitkeep

# User-provided datasets (not example data)
ki-turb_multi_agents/user/
**/user/DNS/
**/user/LES/

# Local agent / knowledge scratch (keep committed recipes)
ki-turb_multi_agents/knowledge/lessons/lessons.local.jsonl

# -----------------------------------------------------------------------------
# C / C++ / CFD build artifacts
# -----------------------------------------------------------------------------
*.o
*.a
*.os
*.lo
*.la
*.obj
*.exe
*.out
*.app
*.dll
*.dylib
*.mod
*.smod
*.d
*.dblite
*.gch
*.pch
compile_commands.json
CMakeCache.txt
CMakeFiles/
cmake-build-*/
Makefile.local

# Solver build trees
cfd_solvers/**/build/
cfd_solvers/**/tmp/
cfd_solvers/openLB/build/
cfd_solvers/SolverApps/**/tmp/
cfd_solvers/SolverApps/**/*.o
cfd_solvers/SolverApps/**/*.d

# Built solver binaries (keep sources + Makefiles)
cfd_solvers/SolverApps/kiTurbHIT3D/kiTurbHIT3D
cfd_solvers/openLB/examples/**/poiseuille3d
cfd_solvers/openLB/examples/**/*.o

# -----------------------------------------------------------------------------
# LaTeX / presentation build products (keep .tex / .pdf sources)
# -----------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# -----------------------------------------------------------------------------
# Editors & OS
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.ccls-cache/
.vs/
*.code-workspace

# -----------------------------------------------------------------------------
# Misc tooling
# -----------------------------------------------------------------------------
*.tmp
*.tmpfile
*.temp
*.bak
*.orig
*.rej
core
core.*
.direnv/
.python-version
.nvmrc
node_modules/
